# =========================================================
# ULTRON AI AGENT - API PROVIDER CONFIGURATION
# =========================================================

# 1. Local LLM via Ollama (100% Offline)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# 2. GitHub Models (Completely Free with GitHub Account)
# Get a personal access token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# 3. Groq Cloud (Free Tier - Ultra High Speed Inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 4. Google Gemini Developer API (Free Tier)
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=

# 5. OpenRouter (:free Models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

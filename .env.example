# ULTRON Local Autonomous Agent Environment Variables
# Copy to .env for local overrides (never commit .env to source control)

# Primary AI Provider (Default: ollama)
AI_PROVIDER=ollama

# Ollama Local Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m

# Regional / Language Settings
DEFAULT_LANGUAGE=auto

# Feature Toggles
ENABLE_VOICE=true
ENABLE_MEMORY=true
ENABLE_ANDROID=true
ENABLE_DESKTOP=true
ENABLE_WEB_SEARCH=true

# Phone / ADB Settings
ADB_PATH=C:\Users\prgc\AppData\Local\Android\Sdk\platform-tools\adb.exe
ADB_DEVICE_IP=10.157.202.42:5555

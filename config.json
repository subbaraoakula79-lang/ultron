{
    "ai_provider": "ollama",
    "ollama": {
        "host": "http://localhost:11434",
        "model": "qwen3.5:2b-q4_K_M",
        "fallback_model": "qwen3:1.7b",
        "timeout_seconds": 120,
        "temperature": 0.3,
        "num_ctx": 4096,
        "keep_alive": "5m"
    },
    "automation": {
        "daemon_tick_interval_seconds": 5,
        "health_check_interval_seconds": 300,
        "auto_cleanup_temp_interval_seconds": 21600,
        "thresholds": {
            "cpu_percent_warning": 80.0,
            "ram_percent_warning": 85.0,
            "disk_percent_warning": 90.0
        },
        "watch_paths": [
            "C:\\Users\\prgc\\Downloads"
        ],
        "auto_organize_downloads": false,
        "temp_clean_older_than_days": 2
    },
    "logging": {
        "log_file": "ultron.log",
        "log_level": "INFO",
        "desktop_notifications": true
    },
    "features": {
        "enable_voice": true,
        "enable_memory": true,
        "enable_android": true,
        "enable_desktop": true,
        "enable_web_search": true,
        "default_language": "auto"
    }
}
